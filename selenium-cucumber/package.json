{
  "name": "toolshop-selenium-cucumber",
  "version": "1.0.0",
  "private": true,
  "description": "BDD tests for the Toolshop practice web shop with Cucumber and Selenium WebDriver",
  "scripts": {
    "test": "cucumber-js",
    "test:headed": "cross-env HEADLESS=false cucumber-js",
    "test:smoke": "cucumber-js --tags @smoke",
    "test:with-bugs": "cross-env BASE_URL=https://with-bugs.practicesoftwaretesting.com cucumber-js"
  },
  "devDependencies": {
    "@cucumber/cucumber": "13.3.0",
    "cross-env": "10.1.0",
    "selenium-webdriver": "4.52.0"
  }
}
